{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["api/**/*.ts", "packages/api/**/*.ts", "packages/config/**/*.ts", "packages/db/index.ts"]
}