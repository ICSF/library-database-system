generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  previewFeatures        = ["partialIndexes", "views"]
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model authors {
  author_id Int     @id @default(autoincrement())
  name      String
  items     items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model committee {
  user_id                            String  @id(map: "staff_access_pkey") @db.Uuid
  role                               String?
  isHeadLibrarian                    Boolean @default(false)
  loans_loans_issued_byTocommittee   loans[] @relation("loans_issued_byTocommittee")
  loans_loans_returned_byTocommittee loans[] @relation("loans_returned_byTocommittee")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model departments {
  department_id Int       @id(map: "departmentss_pkey") @default(autoincrement())
  name          String
  members       members[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_templates {
  name     String @id
  title    String
  template String
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model items {
  item_id       Int         @id @default(autoincrement())
  type_id       Int         @default(0)
  location_id   Int         @default(0)
  author_id     Int         @default(0)
  title         String
  series        String?
  series_num    String?
  comments      String?
  reviews       String?
  is_damaged    Boolean     @default(false)
  is_awol       Boolean     @default(false)
  acquire_date  DateTime?   @db.Date
  donated_by    String?
  is_borrowable Boolean     @default(true)
  is_retired    Boolean     @default(false)
  retire_date   DateTime?   @db.Date
  isbn          String?
  authors       authors     @relation(fields: [author_id], references: [author_id])
  locations     locations   @relation(fields: [location_id], references: [location_id])
  media_types   media_types @relation(fields: [type_id], references: [media_type_id])
  loans         loans?

  @@index([author_id], map: "items_AuthorKey_idx")
  @@index([is_retired, acquire_date], map: "items_Retired_2_idx")
  @@index([is_retired], map: "items_Retired_idx")
  @@index([type_id, author_id, series], map: "items_TypeKey_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model loans {
  loan_id                                BigInt     @id @default(autoincrement())
  item_id                                Int        @unique(map: "loans_one_open_loan_per_item_idx", where: raw("(returned_at IS NULL)"))
  member_id                              String     @db.Uuid
  issued_at                              DateTime   @default(now()) @db.Timestamptz(6)
  due_at                                 DateTime   @db.Date
  returned_at                            DateTime?  @db.Timestamptz(6)
  issued_by                              String?    @db.Uuid
  returned_by                            String?    @db.Uuid
  notes                                  String?
  reminder_count                         Int        @default(0)
  committee_loans_issued_byTocommittee   committee? @relation("loans_issued_byTocommittee", fields: [issued_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  items                                  items      @relation(fields: [item_id], references: [item_id], onUpdate: NoAction)
  members                                members    @relation(fields: [member_id], references: [member_id], onUpdate: NoAction)
  committee_loans_returned_byTocommittee committee? @relation("loans_returned_byTocommittee", fields: [returned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "loans_member_idx")
  @@index([due_at], map: "loans_open_due_at_idx", where: raw("(returned_at IS NULL)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model locations {
  location_id Int     @id @default(autoincrement())
  name        String
  items       items[]

  @@index([name], map: "locations_Location_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model media_types {
  media_type_id Int     @id @default(autoincrement())
  media_type    String
  items         items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_memberships {
  member_id       String  @db.Uuid
  membership_year Int
  notes           String?
  members         members @relation(fields: [member_id], references: [member_id], onUpdate: NoAction)

  @@id([member_id, membership_year])
  @@index([membership_year, member_id], map: "member_memberships_year_member_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_types {
  member_type_id Int       @id @default(autoincrement())
  member_type    String
  members        members[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  member_id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name         String
  last_name          String
  member_type_id     Int?
  dept_id            Int?
  uni_year           String?
  email              String               @unique
  comments           String?
  join_date          DateTime?            @db.Date
  is_disabled        Boolean              @default(false)
  disabled_reason    String?
  loans              loans[]
  member_memberships member_memberships[]
  departments        departments?         @relation(fields: [dept_id], references: [department_id], onDelete: Restrict)
  member_types       member_types?        @relation(fields: [member_type_id], references: [member_type_id], onDelete: Restrict)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model membership_settings {
  singleton               Boolean @id @default(true)
  current_membership_year Int
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scratch {
  name  String @id
  value String
}

view catalogue_search {
  id          BigInt?
  title       String?
  series      String?
  series_num  String?
  author_name String?
  isbn        String?
}

view current_members {
  member_id        String?   @db.Uuid
  first_name       String?
  last_name        String?
  member_type_id   Int?
  dept_id          Int?
  uni_year         String?
  email            String?
  join_date        DateTime? @db.Date
  is_disabled      Boolean?
  disabled_reason  String?
  comments         String?
  membership_notes String?
}

/// This view or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
view overdue_loans {
  loan_id      BigInt?
  item_id      Int?
  title        String?
  member_id    String?   @db.Uuid
  first_name   String?
  last_name    String?
  email        String?
  issued_at    DateTime? @db.Timestamptz(6)
  due_at       DateTime? @db.Date
  days_overdue Int?
  notes        String?
}

view catalogue {
  item_id       Int?
  title         String?
  author_name   String?
  series_name   String?
  series_num    String?
  item_type     String?
  location      String?
  comments      String?
  reviews       String?
  isbn          String?
  is_borrowable Boolean?
  is_damaged    Boolean?
  is_awol       Boolean?
  is_retired    Boolean?
  retire_date   DateTime? @db.Date
  acquire_date  DateTime? @db.Date
  donated_by    String?
}
