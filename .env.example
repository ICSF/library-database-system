DATABASE_URL=postgresql://user:password@host:5432/postgres
NODE_ENV=development
SUPABASE_URL=https://{project_name}.supabase.co
SUPABASE_SECRET_KEY=sb_secret_{secret_key}

# Used by the Vite frontend. All frontend .env variables must start with VITE_ to be exposed to the frontend.
VITE_SUPABASE_URL=https://{project_name}.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_{key}
VITE_API_URL=https://route_to_api
